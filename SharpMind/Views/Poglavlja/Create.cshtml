@model SharpMind.Models.Poglavlje
@{
    ViewData["Title"] = "Novo poglavlje";
    string boja = "#4169E1";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border border-2 border-dark" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header text-white py-3 text-center border-bottom border-2 border-dark" style="background-color:@boja;">
                    <h5 class="mb-0 fw-bold text-uppercase">
                        <i class="bi bi-card-text me-2"></i> Kreiraj Poglavlje
                    </h5>
                </div>

                <div class="card-body p-5 bg-white">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold small"></div>

                        <div class="mb-5">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Naziv poglavlja</label>
                            <input type="text" name="PoglavljeNaziv" value="@Model?.PoglavljeNaziv"
                                   class="form-control form-control-lg border-2 border-dark shadow-sm"
                                   placeholder="npr. Uvod u C#..." required
                                   style="border-radius: 8px;" />
                            <span asp-validation-for="PoglavljeNaziv" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn text-white fw-bold py-3 shadow text-uppercase"
                                    style="background-color:@boja; border-radius: 8px;">
                                <i class="bi bi-check-lg me-2"></i> Sačuvaj poglavlje
                            </button>

                            <a href="/Poglavlja/Index" class="btn btn-dark fw-bold py-3 shadow text-uppercase"
                               style="border-radius: 8px;">
                                <i class="bi bi-x-circle me-2"></i> Otkaži
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .form-control:focus {
        border-color: @boja !important;
        box-shadow: 0 0 0 0.25rem rgba(65, 105, 225, 0.15) !important;
    }
</style>