@model IEnumerable<SharpMind.Models.Kviz>
@{
    ViewData["Title"] = "Kvizovi";
    string boja = "#007bff"; 
    bool isAdmin = ViewBag.IsAdmin ?? false;
    int? trenutniKorisnikId = ViewBag.TrenutniKorisnikId;

    bool jeMenadzer = User.IsInRole("Admin") || User.IsInRole("Profesor");
}

<div class="container mt-5">
    @if (TempData["Greska"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border border-2 border-dark mb-4 shadow" style="border-radius: 10px;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Greska"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-black text-uppercase" style="letter-spacing: 2px;">Dostupni Kvizovi</h2>
            <p class="text-muted">Izaberite izazov i testirajte svoje znanje.</p>
        </div>

        @if (jeMenadzer)
        {
            <a href="/Kviz/Create" class="btn btn-primary shadow-lg px-4 py-2" style="background-color: @boja; border-radius: 10px; border-color: @boja;">
                <i class="bi bi-plus-circle me-2"></i> Novi Kviz
            </a>
        }
    </div>

    <div class="row">
        @foreach (var kviz in Model)
        {
            bool imaPravoUpravljanja = isAdmin || (trenutniKorisnikId != null && kviz.KorisnikId == trenutniKorisnikId);

            <div class="col-md-4 mb-5">
                <div class="card h-100 shadow-lg border-2 border-dark" style="border-radius: 20px; overflow: hidden; min-height: 550px;">
                    <div class="card-header text-white py-4 text-center border-bottom border-2 border-dark" style="background-color:@boja;">
                        <h5 class="fw-bolder mb-0 text-uppercase text-truncate d-inline-block w-100"
                            style="letter-spacing: 1px;"
                            title="@kviz.KvizNaslov">
                            @kviz.KvizNaslov
                        </h5>
                    </div>

                    <div class="card-body p-4 d-flex flex-column bg-white text-center">
                        <div class="mb-4">
                            <i class="bi bi-controller display-2" style="color:@boja;"></i>
                        </div>

                        <div class="flex-grow-1">
                            <ul class="list-group list-group-flush mb-4">
                                <li class="list-group-item border-0 py-3">
                                    <span class="text-muted fw-black text-uppercase small d-block">Kreator:</span>
                                    <span class="fs-5 fw-bold text-dark">@(kviz.Kreator?.KorisnikIme ?? "SharpMind Sistem")</span>
                                </li>
                                <li class="list-group-item border-0 py-3">
                                    <span class="text-muted fw-black text-uppercase small d-block">Ukupno Pitanja:</span>
                                    <span class="fs-5 fw-bold text-dark">@kviz.KvizPitanja.Count</span>
                                </li>
                                <li class="list-group-item border-0 py-3">
                                    <span class="text-muted fw-black text-uppercase small d-block">Tip Izazova:</span>
                                    <span class="badge px-3 py-2 text-uppercase bg-dark">@kviz.TipKviza</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-4 border-top border-1">
                            <button class="btn btn-dark w-100 fw-bold py-3 shadow text-uppercase mb-2"
                                    style="border-radius: 10px;"
                                    onclick="potvrdiPocetak(@kviz.KvizId, '@kviz.KvizNaslov')">
                                <i class="bi bi-play-circle-fill me-2"></i> Započni Kviz
                            </button>

                            @if (imaPravoUpravljanja)
                            {
                                <div class="d-flex gap-2 w-100 mt-2">
                                    <a href="/Kviz/Edit/@kviz.KvizId" class="btn btn-outline-primary fw-bold w-50" style="border-radius: 10px;">Izmeni</a>

                                    <form action="/Kviz/Delete/@kviz.KvizId" method="post" class="w-50" onsubmit="return confirm('Sigurno brišete ovaj kviz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger fw-bold w-100" style="border-radius: 10px;">Obriši</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-2 border-dark" style="border-radius: 20px;">
            <div class="modal-body text-center p-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-octagon display-1 text-warning"></i>
                </div>
                <h3 id="modalKvizNaslov" class="fw-black text-uppercase mb-3 text-truncate w-100"></h3>
                <p class="fs-5 text-muted mb-5">Da li ste spremni da započnete ovaj izazov?</p>
                <div class="d-grid gap-3">
                    <a id="btnStartGame" href="#" class="btn btn-dark py-3 fw-bold text-uppercase" style="border-radius: 10px;">ZAPOČNI ODMAH</a>
                    <button type="button" class="btn btn-link text-dark fw-bold text-decoration-none" data-bs-dismiss="modal">ODUSTANI</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function potvrdiPocetak(id, naslov) {
        document.getElementById('modalKvizNaslov').innerText = naslov;
        document.getElementById('btnStartGame').href = '/Kviz/Igraj/' + id;
        new bootstrap.Modal(document.getElementById('confirmModal')).show();
    }
</script>