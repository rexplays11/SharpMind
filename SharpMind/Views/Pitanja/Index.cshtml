@model IEnumerable<SharpMind.Models.Pitanje>

@{
    ViewData["Title"] = "Baza Pitanja";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.CurrentPageSize ?? 25;
    int totalItems = ViewBag.TotalItems ?? 0;
    string currentSort = ViewBag.CurrentSort ?? "id_desc";
    string sivaBoja = "#c5c8c1";

    int startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int endItem = Math.Min(startItem + Model.Count() - 1, totalItems);
}

<style>
    .btn-gold {
        background-color: @sivaBoja !important;
        color: white !important;
        border: none;
        font-weight: bold;
    }

        .btn-gold:hover {
            background-color: @sivaBoja !important;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .table-custom-header th {
        background-color: @sivaBoja !important;
        color: #2d2d2d !important;
        border: none !important;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .page-item.active .page-link {
        background-color: @sivaBoja !important;
        border-color: sivaBoja !important;
        color: white !important;
    }

    .page-link {
        color: @sivaBoja;
        font-weight: bold;
    }

    .gold-text {
        color: @sivaBoja !important;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-question-square gold-text"></i> Baza Pitanja</h2>
            <p class="text-muted mb-0">
                Prikazano <span class="fw-bold text-dark">@startItem - @endItem</span>
                od ukupno <span class="fw-bold text-dark">@totalItems</span> pitanja |
                Stranica <span class="fw-bold text-dark">@currentPage</span> od @totalPages
            </p>
        </div>

        <div class="d-flex gap-3 align-items-center">
            <div class="d-flex align-items-center bg-white border rounded px-2 shadow-sm">
                <label class="me-2 small fw-bold text-muted text-nowrap">Prikaži:</label>
                <select id="pageSizeSelect" class="form-select form-select-sm border-0" onchange="changePageSize()">
                    <option value="25" selected="@(pageSize == 25)">25</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                </select>
            </div>

            <a href="/Pitanja/Create" class="btn btn-gold shadow-sm px-4">
                <i class="bi bi-plus-circle"></i> Novo Pitanje
            </a>
        </div>
    </div>

    <div class="card shadow border-0" style="border-radius:12px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom-header">
                        <tr>
                            <th class="ps-4">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.IdSortParm, pageSize = pageSize, page = 1 })" class="text-decoration-none text-dark">
                                    ID <i class="bi @(currentSort == "id_asc" ? "bi-sort-numeric-up" : "bi-sort-numeric-down-alt") ms-1 gold-text"></i>
                                </a>
                            </th>
                            <th style="width: 40%;">Tekst Pitanja</th>
                            <th>Kreator</th>
                            <th>Tip</th>
                            <th class="text-center">Nivo</th>
                            <th class="text-center">Odgovora</th>
                            <th class="text-end pe-4">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge border text-dark" style="background-color: #f8f9fa;">#@item.PitanjeId</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 450px;" title="@item.PitanjeTekst">
                                        @item.PitanjeTekst
                                    </div>
                                </td>
                                <td> @(item.Kreator?.KorisnikIme ?? "Sistem")</td>
                                <td><span class="badge bg-light text-dark border">@item.PitanjeTip</span></td>
                                <td class="text-center"><span class="badge rounded-pill bg-dark">@item.Nivo.NazivNivoa</span></td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light text-dark border px-3">@item.Odgovori?.Count</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a href="/Pitanja/Details/@item.PitanjeId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                                        <a href="/Pitanja/Edit/@item.PitanjeId" class="btn btn-sm btn-outline-dark"><i class="bi bi-pencil"></i></a>
                                        <form action="/Pitanja/Delete/@item.PitanjeId" method="post" class="d-inline" onsubmit="return confirm('Da li ste sigurni da želite da obrišete pitanje &quot;@item.PitanjeTekst&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage - 1)&pageSize=@pageSize&sortOrder=@currentSort">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&pageSize=@pageSize&sortOrder=@currentSort">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage + 1)&pageSize=@pageSize&sortOrder=@currentSort">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function changePageSize() {
            const size = document.getElementById("pageSizeSelect").value;
            window.location.href = `/Pitanja/Index?page=1&pageSize=${size}&sortOrder=@currentSort`;
        }
    </script>
}