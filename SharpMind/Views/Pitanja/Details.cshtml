@model SharpMind.Models.Pitanje
@{
    string sivaBoja = "#c5c8c1";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-2 border-dark" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header text-dark py-3 text-center border-bottom border-2 border-dark" style="background-color:@sivaBoja;">
                    <h5 class="fw-bolder mb-0 text-uppercase">
                        <i class="bi bi-question-square me-2"></i> Informacije o Pitanju
                    </h5>
                </div>

                <div class="card-body p-5 text-center bg-white">
                    <div class="mb-5">
                        <i class="bi bi-question-square display-3" style="color:@sivaBoja;"></i>
                    </div>

                    <div class="mb-4">
                        <small class="text-dark fw-black text-uppercase d-block mb-2 text-center">Tekst Pitanja:</small>
                        <h3 class="fw-bold p-4 border border-2 border-dark rounded shadow-sm bg-light" style="color:@sivaBoja;">
                            @Model.PitanjeTekst
                        </h3>
                    </div>

                    <ul class="list-group border-2 border-dark rounded-3 shadow-sm mb-5">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">ID Pitanja:</span>
                            <span class="fw-bold fs-5" style="color:@sivaBoja;">#@Model.PitanjeId</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Tip Pitanja:</span>
                            <span class="fw-bold fs-5 text-uppercase" style="color:@sivaBoja;">@Model.PitanjeTip</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Nivo Težine:</span>
                            <span class="fw-bold fs-5" style="color:@sivaBoja;">@(Model.Nivo?.NazivNivoa ?? "N/A")</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-0 bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Autor:</span>
                            <span class="fw-bold fs-5" style="color:@sivaBoja;">@Model.Kreator?.KorisnikIme</span>
                        </li>
                    </ul>

                    @if (!string.IsNullOrEmpty(Model.BlokKod))
                    {
                        <div class="mb-5 text-start">
                            <small class="text-dark fw-black text-uppercase d-block mb-2 text-center">Prateći Programski Kod:</small>
                            <div class="bg-dark text-white p-3 rounded border border-2 border-dark shadow-sm">
                                <pre class="mb-0 font-monospace" style="font-size: 0.9rem;"><code>@Model.BlokKod</code></pre>
                            </div>
                        </div>
                    }

                    <div class="mb-5">
                        <small class="text-dark fw-black text-uppercase d-block mb-3 text-center">Ponuđeni Odgovori:</small>
                        <div class="list-group border-2 border-dark rounded shadow-sm">
                            @if (Model.Odgovori != null && Model.Odgovori.Any())
                            {
                                foreach (var odg in Model.Odgovori)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center border-dark bg-white py-3 custom-hover">
                                        <span class="fw-bold fs-5" style="color:@(odg.OdgovorTacnost ? "#28a745" : sivaBoja);">
                                            @odg.OdgovorTekst
                                        </span>
                                        @if (odg.OdgovorTacnost)
                                        {
                                            <span class="badge bg-success border border-dark text-uppercase px-3 py-2">TAČNO</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="list-group-item text-muted text-center border-dark py-3">Nema unetih odgovora.</div>
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-3">
                        <a href="/Pitanja/Edit/@Model.PitanjeId"
                           class="btn text-dark fw-bold py-3 shadow border-2 border-dark text-uppercase"
                           style="background-color:@sivaBoja; border-radius: 8px;">
                            <i class="bi bi-pencil-square me-2"></i> Izmeni Pitanje
                        </a>

                        <a href="/Pitanja/Index" class="btn btn-dark fw-bold py-3 shadow text-uppercase" style="border-radius: 8px;">
                            <i class="bi bi-arrow-left me-2"></i> Nazad na listu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .custom-hover {
        transition: all 0.2s ease-in-out;
    }

        .custom-hover:hover {
            background-color: #fcfcfc !important;
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            z-index: 5;
            cursor: pointer;
        }

    pre {
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>