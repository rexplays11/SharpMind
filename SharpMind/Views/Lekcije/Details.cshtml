@model SharpMind.Models.Lekcija
@{
    string boja = "#228B22";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-2 border-dark" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header text-white py-3 text-center border-bottom border-2 border-dark" style="background-color:@boja;">
                    <h5 class="fw-bolder mb-0 text-uppercase">
                        <i class="bi bi-book me-2"></i> Informacije o Lekciji
                    </h5>
                </div>

                <div class="card-body p-5 text-center bg-white">

                    <div class="mb-4">
                        <i class="bi bi-book display-3" style="color:@boja;"></i>
                    </div>


                    <div class="mb-4 text-start">
                        <small class="text-dark fw-black text-uppercase d-block mb-2 text-center">Sadržaj lekcije:</small>
                        <div class="custom-textarea-look p-4 border border-2 border-dark rounded shadow-sm bg-light custom-hover-box">
                            @Html.Raw(Model.LekcijaTekst)
                        </div>
                    </div>

                    <ul class="list-group border-2 border-dark rounded-3 shadow-sm mb-5">

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Naslov:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">@Model.LekcijaNaslov</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Sistemski ID:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">#@Model.LekcijaId</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Nivo Težine:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">
                                @(Model.Nivo?.NazivNivoa ?? "N/A")
                            </span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Poglavlje:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">
                                @(Model.Poglavlje?.PoglavljeNaziv ?? (Model.PoglavljeId.HasValue ? $"# {Model.PoglavljeId}" : "Nije definisano"))
                            </span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-0 bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Potpoglavlje:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">
                                @(Model.Potpoglavlje?.NazivPotpoglavlja ?? (Model.PotpoglavljeId.HasValue ? $"#{Model.PotpoglavljeId}" : "Nije definisano"))
                            </span>
                        </li>
                    </ul>

                    <div class="d-grid gap-3">
                        <a href="/Lekcije/Edit/@Model.LekcijaId"
                           class="btn text-white fw-bold py-3 shadow text-uppercase"
                           style="background-color:@boja; border-radius: 8px;">
                            <i class="bi bi-pencil-square me-2"></i> Izmeni Lekciju
                        </a>

                        <a href="/Lekcije/Index" class="btn btn-dark fw-bold py-3 shadow text-uppercase" style="border-radius: 8px;">
                            <i class="bi bi-arrow-left me-2"></i> Nazad na listu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .custom-textarea-look {
        background-color: #ffffff !important;
        color: #000000 !important;
        min-height: 200px;
        max-height: 350px;
        overflow-y: auto;
        font-size: 1rem;
        line-height: 1.6;
        cursor: default;
        transition: all 0.3s ease;
    }

    .custom-hover-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        border-color: @boja !important;
    }

    .custom-hover {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .custom-hover:hover {
            background-color: #f4f9f4 !important; 
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            z-index: 5;
        }

    .custom-textarea-look::-webkit-scrollbar {
        width: 6px;
    }

    .custom-textarea-look::-webkit-scrollbar-thumb {
        background: @boja;
        border-radius: 10px;
    }

    .custom-textarea-look::-webkit-scrollbar-track {
        background: #f8f9fa;
    }
</style>