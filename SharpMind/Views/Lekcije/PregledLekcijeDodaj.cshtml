@model SharpMind.Models.Lekcija

@{
    ViewData["Title"] = "Nova lekcija";
    string bojaModela = "#228B22";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border border-2 border-dark" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header text-white py-3 text-center border-bottom border-2 border-dark" style="background-color: @bojaModela;">
                    <h5 class="mb-0 fw-bold text-uppercase">
                        <i class="bi bi-journal-plus me-2"></i> Kreiranje nove lekcije
                    </h5>
                </div>

                <div class="card-body p-5 bg-white">
                    <form asp-action="PregledLekcijeDodaj" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="PoglavljeId" value="@Model.PoglavljeId" />
                        <input type="hidden" name="PotpoglavljeId" value="@Model.PotpoglavljeId" />

                        <div class="mb-5">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Naslov Lekcije</label>
                            <input name="LekcijaNaslov" class="form-control form-control-lg border-2 border-dark shadow-sm"
                                   required value="@Model?.LekcijaNaslov" style="border-radius: 8px;" />
                        </div>

                        <div class="mb-5 p-3 border border-2 border-dark bg-light rounded" style="border-radius: 8px;">
                            <small class="fw-bold text-uppercase text-muted" style="letter-spacing: 1px;">
                                Dodaješ lekciju u:
                            </small><br />
                            <span class="fw-black">
                                @ViewBag.PoglavljeNaziv / @ViewBag.PotpoglavljeNaziv
                            </span>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Nivo Težine</label>
                            <select name="NivoId" class="form-select form-select-lg border-2 border-dark shadow-sm" style="border-radius: 8px;">
                                @foreach (var n in ViewBag.Nivoi)
                                {
                                    <option value="@n.NivoId" selected="@(Model?.NivoId == n.NivoId)">
                                        @n.NazivNivoa
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Tekst Lekcije</label>
                            <textarea name="LekcijaTekst" class="form-control border-2 border-dark shadow-sm" rows="6"
                                      placeholder="Unesite sadržaj lekcije..." style="border-radius: 8px;">@Model?.LekcijaTekst</textarea>
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn text-white fw-bold py-3 shadow text-uppercase" style="background-color: @bojaModela; border-radius: 8px;">
                                <i class="bi bi-check-lg me-2"></i> Sačuvaj lekciju
                            </button>
                            <a href="/Poglavlja" class="btn btn-dark fw-bold py-3 shadow text-uppercase" style="border-radius: 8px;">
                                <i class="bi bi-x-circle me-2"></i> Odustani
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .form-control:focus, .form-select:focus {
        border-color: @bojaModela !important;
        box-shadow: 0 0 0 0.25rem rgba(34, 139, 34, 0.15) !important;
    }
</style>