@model IEnumerable<SharpMind.Models.Lekcija>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Sve Lekcije</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Nova Lekcija
        </a>
    </div>

    @foreach (var lekcija in Model)
    {
        <div class="card shadow-sm border-0 mb-4 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-1 bg-success d-none d-md-flex align-items-center justify-content-center">
                    <i class="bi bi-book text-white fs-1"></i>
                </div>

                <div class="col-md-11">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="card-title fw-bold mb-1">@lekcija.LekcijaNaslov</h4>
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb mb-0" style="font-size: 0.9rem;">
                                        <li class="breadcrumb-item text-secondary">@lekcija.Poglavlje?.PoglavljeNaziv</li>
                                        <li class="breadcrumb-item active text-success font-weight-bold">@lekcija.Nivo?.NazivNivoa</li>
                                    </ol>
                                </nav>
                            </div>

                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@lekcija.LekcijaId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@lekcija.LekcijaId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Da li ste sigurni?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>

                        <hr class="my-3 opacity-10">

                        <p class="card-text text-muted">
                            @if (!string.IsNullOrEmpty(lekcija.LekcijaTekst))
                            {
                                @(lekcija.LekcijaTekst.Length > 200 ? lekcija.LekcijaTekst.Substring(0, 200) + "..." : lekcija.LekcijaTekst)
                            }
                        </p>

                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@lekcija.LekcijaId" class="btn btn-primary btn-sm px-4 rounded-pill">
                                Pročitaj lekciju <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>