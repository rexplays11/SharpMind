@model SharpMind.Models.Korisnik
@{
    ViewData["Title"] = "Novi korisnik";
    string boja = "#FF8C00";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border border-2 border-dark" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header text-white py-3 text-center border-bottom border-2 border-dark" style="background-color:@boja;">
                    <h5 class="mb-0 fw-bold text-uppercase">
                        <i class="bi bi-person-plus-fill me-2"></i> Kreiranje korisnika
                    </h5>
                </div>

                <div class="card-body p-5 bg-white">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Korisničko ime</label>
                            <input name="KorisnikIme" class="form-control form-control-lg border-2 border-dark shadow-sm" style="border-radius: 8px;" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Lozinka</label>
                            <input name="KorisnikLozinka" type="password" class="form-control form-control-lg border-2 border-dark shadow-sm" style="border-radius: 8px;" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Datum registracije</label>
                            <input name="KorisnikDatumRegistracije" type="datetime-local" class="form-control form-control-lg border-2 border-dark shadow-sm" style="border-radius: 8px;" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Uloga</label>
                            <select name="UlogaId" class="form-select form-select-lg border-2 border-dark shadow-sm" style="border-radius: 8px;" required>
                                <option value="">-- Izaberi ulogu --</option>
                                @foreach (var u in ViewBag.Uloge)
                                {
                                    <option value="@u.UlogaId">@u.UlogaNaziv</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Nivo</label>
                            <select name="NivoId" class="form-select form-select-lg border-2 border-dark shadow-sm" style="border-radius: 8px;" required>
                                <option value="">-- Izaberi nivo --</option>
                                @foreach (var n in ViewBag.Nivoi)
                                {
                                    <option value="@n.NivoId">@n.NazivNivoa</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Profesor (opciono)</label>
                            <select name="ProfesorId" class="form-select form-select-lg border-2 border-dark shadow-sm" style="border-radius: 8px;">
                                <option value="">-- Nema profesora --</option>
                                @foreach (var p in ViewBag.Profesori)
                                {
                                    <option value="@p.KorisnikId">@p.KorisnikIme</option>
                                }
                            </select>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Ukupno poena</label>
                            <input name="UkupnoPoena" type="number" value="0" class="form-control form-control-lg border-2 border-dark shadow-sm" style="border-radius: 8px;" />
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn text-white fw-bold py-3 shadow text-uppercase" style="background-color:@boja; border-radius: 8px;">
                                <i class="bi bi-check-lg me-2"></i> Sačuvaj korisnika
                            </button>

                            <a href="/Korisnici/Index" class="btn btn-dark fw-bold py-3 shadow text-uppercase" style="border-radius: 8px;">
                                <i class="bi bi-x-circle me-2"></i> Otkaži
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .form-control:focus, .form-select:focus {
        border-color: @boja !important;
        box-shadow: 0 0 0 0.25rem rgba(255, 140, 0, 0.15) !important;
    }
</style>