@model SharpMind.Models.Korisnik
@{
    string boja = "#FF8C00";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-2 border-dark" style="border-radius: 15px; overflow: hidden;">


                <div class="card-header text-white py-3 text-center border-bottom border-2 border-dark" style="background-color:@boja;">
                    <h5 class="fw-bolder mb-0 text-uppercase">
                        <i class="bi bi-people me-2"></i> Informacije o Korisniku
                    </h5>
                </div>

                <div class="card-body p-5 text-center bg-white">


                    <div class="mb-5">
                        <i class="bi bi-people display-1" style="color:@boja;"></i>
                    </div>

                    <ul class="list-group border-2 border-dark rounded-3 shadow-sm">

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">ID Korisnika:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">#@Model.KorisnikId</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Naziv Korisnika:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">@Model.KorisnikIme</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Uloga:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">
                                @(Model.Uloga?.UlogaNaziv ?? "Nema uloge")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Nivo Korisnika:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">@Model.Nivo?.NazivNivoa</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-bottom border-2 border-dark bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Ukupno Poena:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">
                                @Model.UkupnoPoena
                            </span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 border-0 bg-white custom-hover">
                            <span class="text-dark fw-black text-uppercase small">Mentor:</span>
                            <span class="fw-bold fs-5" style="color:@boja;">
                                @(Model.Profesor?.KorisnikIme ?? "Samostalan")
                            </span>
                        </li>
                    </ul>

                    <div class="d-grid gap-3 mt-5">
                        <a href="/Korisnici/StudentEdit/@Model.KorisnikId"
                           class="btn text-white fw-bold py-3 shadow text-uppercase"
                           style="background-color:@boja; border-radius: 8px;">
                            <i class="bi bi-pencil-square me-2"></i> Izmeni podatke
                        </a>

                        <a href="/Korisnici/ListaStudenata" class="btn btn-dark fw-bold py-3 shadow text-uppercase" style="border-radius: 8px;">
                            <i class="bi bi-arrow-left me-2"></i> Nazad na listu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .custom-hover {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .custom-hover:hover {
            background-color: #fff9f2 !important;
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            z-index: 5;
        }
</style>