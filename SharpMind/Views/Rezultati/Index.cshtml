@model IEnumerable<SharpMind.Models.Rezultat>

@{
    ViewData["Title"] = "Pregled Rezultata";
    string zlatnaBoja = "#DAA520";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.CurrentPageSize ?? 25;
    int totalItems = ViewBag.TotalItems ?? 0;
    string currentSort = ViewBag.CurrentSort ?? "";

    int startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int endItem = Math.Min(startItem + Model.Count() - 1, totalItems);
}

<style>
    .btn-gold {
        background-color: @zlatnaBoja !important;
        color: white !important;
        border: none;
    }

        .btn-gold:hover {
            background-color: #b8860b !important;
        }

    .table-gold-header th {
        background-color: @zlatnaBoja !important;
        color: white !important;
        border: none !important;
    }

    .gold-text {
        color: @zlatnaBoja !important;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(218, 165, 32, 0.08) !important;
    }

    .page-item.active .page-link {
        background-color: @zlatnaBoja !important;
        border-color: @zlatnaBoja !important;
        color: white !important;
    }

    .page-link {
        color: @zlatnaBoja;
        font-weight: bold;
    }

        .page-link:hover {
            color: #b8860b;
        }
</style>

<div class="container-fluid mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-trophy gold-text"></i> Rezultati Aktivnosti</h2>
            <p class="text-muted mb-0">
                Prikazano <span class="fw-bold text-dark">@startItem - @endItem</span>
                od ukupno <span class="fw-bold text-dark">@totalItems</span> rezultata |
                Stranica <span class="fw-bold text-dark">@currentPage</span> od @totalPages
            </p>
        </div>

        <div class="d-flex gap-3 align-items-center">
            <div class="d-flex align-items-center bg-white border rounded px-2 shadow-sm">
                <label class="me-2 small fw-bold text-muted text-nowrap">Prikaži:</label>
                <select id="pageSizeSelect" class="form-select form-select-sm border-0" onchange="changePageSize()">
                    <option value="25" selected="@(pageSize == 25)">25</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                </select>
            </div>

            <a href="/Rezultati/Create" class="btn btn-gold shadow-sm px-4">
                <i class="bi bi-plus-circle"></i> Dodaj novi rezultat
            </a>
        </div>
    </div>

    <div class="card shadow border-0" style="border-radius:12px; overflow:hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-gold-header">
                        <tr>
                            <th class="ps-4" style="width:100px;">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.IdSortParm, pageSize = pageSize, page = 1 })" class="text-decoration-none text-white">
                                    ID <i class="bi @(currentSort == "id_asc" ? "bi-sort-numeric-up" : "bi-sort-numeric-down-alt") ms-1"></i>
                                </a>
                            </th>
                            <th>Korisnik</th>
                            <th>Nivo</th>
                            <th>Tip</th>
                            <th class="text-center">Rezultat</th>
                            <th>Datum</th>
                            <th class="text-end pe-4">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="badge bg-light text-muted border">#@item.RezultatId</span></td>
                                <td><span class="fw-bold text-dark">@item.Korisnik?.KorisnikIme</span></td>
                                <td><span class="badge border gold-text">@item.Nivo?.NazivNivoa</span></td>
                                <td class="small fw-bold text-uppercase">@item.TipAktivnosti</td>
                                <td class="text-center">
                                    <span class="fw-bold text-success">@item.OsvojeniPoeni</span> / @item.UkupnoPoena
                                </td>
                                <td class="text-muted small">@item.DatumPolaganja.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a href="/Rezultati/Details/@item.RezultatId" class="btn btn-sm btn-outline-secondary" title="Detalji"><i class="bi bi-eye"></i></a>
                                        <a href="/Rezultati/Edit/@item.RezultatId" class="btn btn-sm btn-outline-primary" title="Izmeni"><i class="bi bi-pencil"></i></a>

                                        <form action="@Url.Action("Delete", "Rezultati", new { id = item.RezultatId })" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0;"
                                                    title="Obriši"
                                                    onclick="return confirm('Sigurno želite da obrišete ovaj rezultat?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage - 1)&pageSize=@pageSize&sortOrder=@currentSort"><i class="bi bi-chevron-left"></i></a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&pageSize=@pageSize&sortOrder=@currentSort">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage + 1)&pageSize=@pageSize&sortOrder=@currentSort"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function changePageSize() {
            const size = document.getElementById("pageSizeSelect").value;
            window.location.href = `/Rezultati/Index?page=1&pageSize=${size}&sortOrder=@currentSort`;
        }
    </script>
}