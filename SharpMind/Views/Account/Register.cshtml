@model SharpMind.Models.Korisnik
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <title>Registracija - SharpMind</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .register-card {
            width: 100%;
            max-width: 400px;
            border-top: 6px solid #8fb997;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .btn-custom {
            background-color: #8fb997;
            color: white;
        }

            .btn-custom:hover {
                background-color: #7aa582;
                color: white;
            }
    </style>
</head>
<body>
    <div class="card register-card p-4 bg-white">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-secondary">Napravi nalog</h2>
            <p class="text-muted small">Postani deo SharpMind zajednice</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 small text-center">@ViewBag.Error</div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small fw-bold">Korisničko ime</label>
                <input type="text" name="KorisnikIme" class="form-control" placeholder="Izaberi korisničko ime" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Lozinka</label>
                <input type="password" name="KorisnikLozinka" class="form-control" placeholder="Unesi lozinku" required />
            </div>

            <button type="submit" class="btn btn-custom w-100 py-2 fw-bold shadow-sm">Registruj se</button>
        </form>

        <div class="text-center mt-4">
            <span class="text-muted small">Već imaš nalog?</span>
            <a href="/Account/Login" class="small fw-bold" style="color: #8fb997; text-decoration: none;"> Prijavi se</a>
        </div>
    </div>
</body>
</html>