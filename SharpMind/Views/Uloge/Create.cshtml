@model SharpMind.Models.Uloga
@{
    ViewData["Title"] = "Kreiranje uloge";
    string boja = "#191970";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border border-2 border-dark" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header text-white py-3 text-center border-bottom border-2 border-dark" style="background-color:@boja;">
                    <h5 class="mb-0 fw-bold text-uppercase">
                        <i class="bi bi-plus-circle-dotted me-2"></i> Kreiraj Novu Ulogu
                    </h5>
                </div>

                <div class="card-body p-5 bg-white">
                    <form asp-controller="Uloge" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold small mb-3"></div>

                        <div class="mb-5">
                            <label class="form-label fw-black text-dark text-uppercase small" style="letter-spacing: 1px;">Naziv nove uloge</label>

                            <input type="text"
                                   name="UlogaNaziv"
                                   class="form-control form-control-lg border-2 shadow-sm @(ViewData.ModelState["UlogaNaziv"]?.Errors.Count > 0 ? "border-danger is-invalid" : "border-dark")"
                                   placeholder="npr. Admin..."
                                   required
                                   value="@Model?.UlogaNaziv"
                                   style="border-radius: 8px;" />

                            @if (ViewData.ModelState["UlogaNaziv"]?.Errors.Count > 0)
                            {
                                <div class="text-danger fw-bold small mt-2">
                                    <i class="bi bi-exclamation-octagon-fill"></i>
                                    @ViewData.ModelState["UlogaNaziv"].Errors[0].ErrorMessage
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn text-white fw-bold py-3 shadow" style="background-color:@boja; border-radius: 8px;">
                                <i class="bi bi-check-lg me-2"></i> SAČUVAJ ULOGU
                            </button>

                            <a href="/Uloge/Index" class="btn btn-dark fw-bold py-3 shadow text-uppercase" style="border-radius: 8px;">
                                <i class="bi bi-x-circle me-2"></i> Otkaži
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .form-control:focus {
        border-color: @boja !important;
        box-shadow: 0 0 0 0.25rem rgba(25, 25, 112, 0.1);
    }
</style>